  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main forward action of a screen (Emitir facturas, Registar pagamento).",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 12h14M12 5v14\"/></svg>Emitir facturas</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border:none;border-radius:9999px;background:var(--color-brand,#11804a);color:#fff;font:500 14px/1 var(--font-sans,Geist,system-ui,sans-serif);cursor:pointer;transition:background-color .15s}.ds-btn-primary:hover{background:var(--color-brand-strong,#0e6b3a)}.ds-btn-primary:active{background:var(--color-brand-deep,#0b4f2c)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-brand,#11804a);outline-offset:2px}"
    },
    {
      "name": "Dark Button",
      "kind": "button",
      "refersTo": "button-dark",
      "description": "Neutral heavy action such as Exportar.",
      "html": "<button class=\"ds-btn-dark\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 15V3M7 10l5 5 5-5M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/></svg>Exportar</button>",
      "css": ".ds-btn-dark{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border:none;border-radius:9999px;background:var(--color-ink,#111714);color:#fff;font:500 14px/1 var(--font-sans,Geist,system-ui,sans-serif);cursor:pointer;transition:background-color .15s}.ds-btn-dark:hover{background:#26302b}.ds-btn-dark:active{background:#000}.ds-btn-dark:focus-visible{outline:2px solid var(--color-brand,#11804a);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Companion action next to a primary (Enviar lembretes).",
      "html": "<button class=\"ds-btn-secondary\">Enviar lembretes</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border:1px solid var(--color-line,#e5e9e6);border-radius:9999px;background:var(--color-sunken,#f6f7f6);color:var(--color-ink,#111714);font:500 14px/1 var(--font-sans,Geist,system-ui,sans-serif);cursor:pointer;transition:background-color .15s}.ds-btn-secondary:hover{background:rgb(229 233 230 / .7)}.ds-btn-secondary:active{background:var(--color-line,#e5e9e6)}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-brand,#11804a);outline-offset:2px}"
    },
    {
      "name": "Channel Tags",
      "kind": "chip",
      "refersTo": "channel-tag-mpesa",
      "description": "Solid painted-sign tag per payment rail; one family, four colours.",
      "html": "<span class=\"ds-tags\"><span class=\"ds-tag ds-tag-mpesa\">M-PESA</span><span class=\"ds-tag ds-tag-emola\">E-MOLA</span><span class=\"ds-tag ds-tag-banco\">BANCO</span><span class=\"ds-tag ds-tag-caixa\">NUMERÁRIO</span></span>",
      "css": ".ds-tags{display:inline-flex;gap:8px;flex-wrap:wrap}.ds-tag{display:inline-flex;align-items:center;height:20px;padding:0 6px;border-radius:4px;font:700 10.5px/1 var(--font-sans,Geist,system-ui,sans-serif);letter-spacing:.04em;white-space:nowrap;color:#fff}.ds-tag-mpesa{background:var(--color-mpesa,#c2271f)}.ds-tag-emola{background:var(--color-emola,#f2b705);color:#2a2000}.ds-tag-banco{background:var(--color-banco,#3a5c8f)}.ds-tag-caixa{background:var(--color-caixa,#5b645f)}"
    },
    {
      "name": "Status Pills",
      "kind": "chip",
      "refersTo": "pill-ok",
      "description": "Reconciliation and debt states with a dot; distinct from channel hues.",
      "html": "<span class=\"ds-pills\"><span class=\"ds-pill ds-ok\"><i></i>Reconciliado</span><span class=\"ds-pill ds-warn\"><i></i>Parcial</span><span class=\"ds-pill ds-danger\"><i></i>Por identificar</span><span class=\"ds-pill ds-info\"><i></i>Acordo activo</span></span>",
      "css": ".ds-pills{display:inline-flex;gap:8px;flex-wrap:wrap}.ds-pill{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 10px;border-radius:9999px;font:500 12px/1 var(--font-sans,Geist,system-ui,sans-serif);white-space:nowrap}.ds-pill i{width:6px;height:6px;border-radius:9999px;background:currentColor}.ds-ok{background:var(--color-brand-soft,#e7f4ec);color:var(--color-brand-strong,#0e6b3a)}.ds-warn{background:var(--color-warn-soft,#fff4e5);color:var(--color-warn,#b45309)}.ds-danger{background:var(--color-danger-soft,#fbeaf2);color:var(--color-danger,#a3185e)}.ds-info{background:var(--color-info-soft,#e3f2f3);color:var(--color-info,#0f6670)}"
    },
    {
      "name": "Card with Booth Tiles",
      "kind": "card",
      "refersTo": "card",
      "description": "White card with icon-tile header; inner grouping by sunken tiles, never nested cards.",
      "html": "<section class=\"ds-card\"><div class=\"ds-card-h\"><span class=\"ds-icon\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1\"/><path d=\"M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4\"/></svg></span><h3>Balcões de hoje</h3></div><div class=\"ds-tiles\"><div class=\"ds-tile\"><span class=\"ds-t\" style=\"background:#c2271f\">M-PESA</span><p class=\"ds-amt\">96 450,00 MT</p><p class=\"ds-cap\">18 pagamentos</p><p class=\"ds-open\">Aberto</p></div><div class=\"ds-tile ds-closed\"><span class=\"ds-t\" style=\"background:#5b645f\">NUMERÁRIO</span><p class=\"ds-amt\" style=\"color:#4a544f\">6 000,00 MT</p><p class=\"ds-cap\">1 pagamento</p><p class=\"ds-cap\">Fechado</p></div></div></section>",
      "css": ".ds-card{max-width:380px;padding:20px;background:var(--color-surface,#fff);border:1px solid var(--color-line,#e5e9e6);border-radius:16px;box-shadow:0 1px 2px rgb(17 23 20 / .04),0 1px 1px rgb(17 23 20 / .02);font-family:var(--font-sans,Geist,system-ui,sans-serif);color:var(--color-ink,#111714)}.ds-card-h{display:flex;align-items:center;gap:12px}.ds-card-h h3{margin:0;font-size:17px;font-weight:600;letter-spacing:-.01em}.ds-icon{display:grid;place-items:center;width:40px;height:40px;border:1px solid var(--color-line,#e5e9e6);border-radius:12px;color:var(--color-ink-2,#4a544f)}.ds-tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px}.ds-tile{padding:14px;border-radius:12px;background:var(--color-sunken,#f6f7f6);transition:background-color .2s}.ds-tile:hover{background:var(--color-line,#e5e9e6)}.ds-closed{background:#fff;border:1px dashed var(--color-line-strong,#d3d9d5)}.ds-closed:hover{background:#fff}.ds-t{display:inline-flex;align-items:center;height:20px;padding:0 6px;border-radius:4px;color:#fff;font-size:10.5px;font-weight:700;letter-spacing:.04em}.ds-amt{margin:12px 0 0;font-size:17px;font-weight:600;letter-spacing:-.01em;font-variant-numeric:tabular-nums}.ds-cap{margin:2px 0 0;font-size:12px;color:var(--color-ink-3,#646e68)}.ds-open{margin:8px 0 0;font-size:12px;font-weight:500;color:var(--color-brand-strong,#0e6b3a)}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Top-bar pill search for fracção or referência; sunken at rest, white on focus.",
      "html": "<label class=\"ds-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input type=\"search\" placeholder=\"Pesquisar fracção ou referência\"></label>",
      "css": ".ds-search{position:relative;display:flex;align-items:center;width:360px;height:40px;color:var(--color-ink-3,#646e68)}.ds-search svg{position:absolute;left:14px;pointer-events:none}.ds-search input{width:100%;height:40px;padding:0 16px 0 40px;border:1px solid var(--color-line,#e5e9e6);border-radius:9999px;background:var(--color-sunken,#f6f7f6);color:var(--color-ink,#111714);font:400 14px var(--font-sans,Geist,system-ui,sans-serif);caret-color:var(--color-brand,#11804a);transition:border-color .15s,background-color .15s}.ds-search input::placeholder{color:var(--color-ink-3,#646e68)}.ds-search input:hover{border-color:var(--color-line-strong,#d3d9d5)}.ds-search input:focus{outline:none;border-color:var(--color-brand,#11804a);background:#fff}"
