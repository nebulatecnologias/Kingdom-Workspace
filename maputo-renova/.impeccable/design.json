      "css": ".ds-field{display:block;width:280px;font-family:var(--font-sans,Geist,system-ui,sans-serif)}.ds-field span{font-size:13px;font-weight:500;color:var(--color-ink-2,#4a544f)}.ds-field input{display:block;width:100%;height:40px;margin-top:6px;padding:0 12px;border:1px solid var(--color-line,#e5e9e6);border-radius:12px;background:#fff;font:400 14px inherit;color:var(--color-ink,#111714);caret-color:var(--color-brand,#11804a)}.ds-field input:hover{border-color:var(--color-line-strong,#d3d9d5)}.ds-field input:focus{outline:none;border-color:var(--color-brand,#11804a)}"
