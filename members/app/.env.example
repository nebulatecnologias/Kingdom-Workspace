# Copy to .env.local and fill in. Never commit real values.

# Public URL of this app (used in emails and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security: keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend) - Phase 1
RESEND_API_KEY=
EMAIL_FROM="Kingdom Members <hello@yourdomain.co.za>"
EMAIL_REPLY_TO=help@yourdomain.co.za

# Payment gateway (webhooks)
# Signing secret the gateway shows when you create the integration (whsec_...).
GATEWAY_WEBHOOK_SECRET=
# Accept events sent in the gateway's test mode (livemode: false). Turn off at launch.
GATEWAY_ACCEPT_TEST_EVENTS=true
# Remove access while a payment dispute is open (true), or only when the dispute is lost (false).
DISPUTE_SUSPENDS_ACCESS=true
GATEWAY_CHECKOUT_BASE_URL=
CHECKOUT_RETURN_ALLOWLIST=http://localhost:3000

# Invites
INVITE_TTL_DAYS=7

# Scheduled jobs (Vercel Cron): any long random string. Vercel sends it to /api/cron/*.
CRON_SECRET=

# Support
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
