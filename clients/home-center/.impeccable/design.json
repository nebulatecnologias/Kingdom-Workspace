  "components": [
    {
      "name": "Filled Button",
      "kind": "button",
      "refersTo": "button-filled",
      "description": "The one primary action per section header.",
      "html": "<button class=\"ds-b ds-b-f\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M3 14v-2h7v2H3Zm0-4V8h11v2H3Zm0-4V4h11v2H3Zm10 16v-3.08l5.53-5.5q.22-.23.5-.33.28-.09.55-.09.3 0 .58.11.28.11.5.34l.93.92q.2.23.31.5.1.28.1.56 0 .28-.11.57-.11.29-.33.51L15.08 22H13Zm6.58-5.59.93-.97-.93-.92-.95.95.95.94Z\"/></svg>Fechar o dia</button>",
      "css": ".ds-b{font-family:'Google Sans','Segoe UI',system-ui,sans-serif;height:40px;padding:0 24px;border-radius:20px;border:0;cursor:pointer;display:inline-flex;align-items:center;gap:8px;font-weight:500;font-size:14px;line-height:20px;position:relative;overflow:hidden;transition:box-shadow .15s cubic-bezier(.2,0,0,1)}.ds-b::after{content:\"\";position:absolute;inset:0;background:currentColor;opacity:0;transition:opacity .15s;pointer-events:none}.ds-b:hover::after{opacity:.08}.ds-b:active::after{opacity:.12}.ds-b:focus-visible{outline:2px solid var(--primary,#D7383E);outline-offset:2px}.ds-b svg{margin-left:-6px}.ds-b-f{background:var(--primary,#D7383E);color:#fff}.ds-b-f:hover{box-shadow:0 1px 2px rgba(31,26,26,.2),0 2px 6px rgba(31,26,26,.12)}"
    },
    {
      "name": "Tonal, Outlined and Text Buttons",
      "kind": "button",
      "refersTo": "button-tonal",
      "description": "Secondary in-place, alert actions, and tertiary actions.",
      "html": "<div style=\"display:flex;gap:8px;flex-wrap:wrap\"><button class=\"ds-b2 ds-t\">Responder</button><button class=\"ds-b2 ds-o\">Contactar</button><button class=\"ds-b2 ds-x\">Ver equipas</button></div>",
      "css": ".ds-b2{font-family:'Google Sans','Segoe UI',system-ui,sans-serif;height:40px;padding:0 24px;border-radius:20px;border:0;cursor:pointer;font-weight:500;font-size:14px;line-height:20px;position:relative;overflow:hidden}.ds-b2::after{content:\"\";position:absolute;inset:0;background:currentColor;opacity:0;transition:opacity .15s;pointer-events:none}.ds-b2:hover::after{opacity:.08}.ds-b2:active::after{opacity:.12}.ds-b2:focus-visible{outline:2px solid var(--primary,#D7383E);outline-offset:2px}.ds-t{background:var(--sel,#FFDAD6);color:var(--on-sel,#73171C)}.ds-o{background:transparent;color:var(--primary,#D7383E);box-shadow:inset 0 0 0 1px var(--outline,#857371)}.ds-x{background:transparent;color:var(--primary,#D7383E);padding:0 12px}"
    },
    {
      "name": "Outlined Text Field",
      "kind": "input",
      "refersTo": "text-field",
      "description": "Outlined field with a permanently floated label on the stroke.",
      "html": "<label class=\"ds-tf\"><span class=\"ds-l\">Valor vendido</span><input value=\"425000\" inputmode=\"numeric\"><span class=\"ds-sfx\">MT</span></label>",
      "css": ".ds-tf{position:relative;display:block;max-width:280px;font-family:'Google Sans','Segoe UI',system-ui,sans-serif;}.ds-l{position:absolute;left:12px;top:-8px;padding:0 4px;background:var(--surface,#fff);font-weight:500;font-size:12px;line-height:16px;color:var(--on-surface-variant,#5C4F4F);pointer-events:none}.ds-tf input{display:block;width:100%;box-sizing:border-box;height:52px;padding:14px 52px 12px 16px;border:1px solid var(--outline,#857371);border-radius:8px;background:var(--surface,#fff);font:400 15px/22px inherit;font-family:inherit;color:var(--on-surface,#1F1A1A);font-variant-numeric:tabular-nums;transition:border-color .15s,box-shadow .15s}.ds-tf input:hover{border-color:var(--on-surface,#1F1A1A)}.ds-tf input:focus{outline:none;border-color:var(--primary,#D7383E);box-shadow:inset 0 0 0 1px var(--primary,#D7383E)}.ds-tf:focus-within .ds-l{color:var(--primary,#D7383E)}.ds-sfx{position:absolute;right:16px;top:15px;color:var(--on-surface-variant,#5C4F4F);font-size:15px}"
    },
    {
      "name": "Filter Chips",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Channel and store filters; selected chips fill rose and gain a check.",
      "html": "<div style=\"display:flex;gap:8px;flex-wrap:wrap\"><button class=\"ds-fc\" aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M9.55 17.65 4.5 12.6l1.4-1.4 3.65 3.65 8.55-8.55 1.4 1.4z\"/></svg>Todos os canais</button><button class=\"ds-fc\" aria-pressed=\"false\">WhatsApp <b>7</b></button><button class=\"ds-fc\" aria-pressed=\"false\">Instagram <b>3</b></button></div>",
      "css": ".ds-fc{font-family:'Google Sans','Segoe UI',system-ui,sans-serif;height:32px;padding:0 12px;border-radius:8px;border:1px solid var(--outline-variant,#DCCFCD);background:var(--surface,#fff);color:var(--on-surface-variant,#5C4F4F);font-weight:500;font-size:14px;display:inline-flex;align-items:center;gap:8px;cursor:pointer;transition:background-color .15s cubic-bezier(.2,0,0,1)}.ds-fc b{font-weight:600;font-size:12px;font-variant-numeric:tabular-nums}.ds-fc:hover{background:var(--surface-high,#F1ECEB);color:var(--on-surface,#1F1A1A)}.ds-fc:focus-visible{outline:2px solid var(--primary,#D7383E);outline-offset:2px}.ds-fc[aria-pressed=\"true\"]{background:var(--sel,#FFDAD6);border-color:var(--sel,#FFDAD6);color:var(--on-sel,#73171C)}.ds-fc svg{margin-left:-4px}"
    },
    {
      "name": "Segmented Store Selector",
      "kind": "custom",
      "refersTo": "segmented-button",
      "description": "Store filter that applies to every section.",
      "html": "<div class=\"ds-seg\" role=\"group\"><button aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M9.55 17.65 4.5 12.6l1.4-1.4 3.65 3.65 8.55-8.55 1.4 1.4z\"/></svg>Todas</button><button aria-pressed=\"false\">Av. de Angola</button><button aria-pressed=\"false\">Baía Mall</button><button aria-pressed=\"false\">Matola</button></div>",
      "css": ".ds-seg{display:inline-flex;height:40px;border:1px solid var(--outline,#857371);border-radius:20px;overflow:hidden;background:var(--surface,#fff)}.ds-seg button{font-family:'Google Sans','Segoe UI',system-ui,sans-serif;border:0;border-left:1px solid var(--outline,#857371);background:transparent;padding:0 14px;font-weight:500;font-size:14px;color:var(--on-surface,#1F1A1A);display:inline-flex;align-items:center;gap:6px;cursor:pointer}.ds-seg button:first-child{border-left:0}.ds-seg button:hover{background:var(--surface-high,#F1ECEB)}.ds-seg button:focus-visible{outline:2px solid var(--primary,#D7383E);outline-offset:-2px}.ds-seg button[aria-pressed=\"true\"]{background:var(--sel,#FFDAD6);color:var(--on-sel,#73171C)}"
    },
    {
      "name": "Navigation Drawer Items",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Drawer items with the rose pill active indicator and badge count.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" class=\"ds-ni\" aria-current=\"page\">Visão geral</a><a href=\"#\" class=\"ds-ni\">Mensagens<span class=\"ds-nb\">13</span></a><a href=\"#\" class=\"ds-ni\">Pedidos e entregas</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px;width:240px;padding:12px;background:var(--bg,#F6F2F1)}.ds-ni{font-family:'Google Sans','Segoe UI',system-ui,sans-serif;display:flex;align-items:center;gap:12px;height:48px;padding:0 16px;border-radius:24px;color:var(--on-surface-variant,#5C4F4F);text-decoration:none;font-weight:500;font-size:14px;transition:background-color .15s cubic-bezier(.2,0,0,1)}.ds-ni:hover{background:var(--surface-high,#F1ECEB);color:var(--on-surface,#1F1A1A)}.ds-ni:focus-visible{outline:2px solid var(--primary,#D7383E);outline-offset:2px}.ds-ni[aria-current=\"page\"]{background:var(--sel,#FFDAD6);color:var(--on-sel,#73171C)}.ds-nb{margin-left:auto;min-width:22px;height:20px;padding:0 6px;border-radius:10px;background:var(--primary,#D7383E);color:#fff;font-weight:600;font-size:11px;line-height:20px;text-align:center}"
    },
    {
      "name": "Primary Tabs",
      "kind": "nav",
      "refersTo": "primary-tab-active",
      "description": "Section tabs; data-entry tabs lead with edit_note.",
      "html": "<nav class=\"ds-tabs\"><a href=\"#\" class=\"ds-tab\" aria-selected=\"true\">Painel</a><a href=\"#\" class=\"ds-tab\" aria-selected=\"false\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M3 14v-2h7v2H3Zm0-4V8h11v2H3Zm0-4V4h11v2H3Zm10 16v-3.08l5.53-5.5q.22-.23.5-.33.28-.09.55-.09.3 0 .58.11.28.11.5.34l.93.92q.2.23.31.5.1.28.1.56 0 .28-.11.57-.11.29-.33.51L15.08 22H13Zm6.58-5.59.93-.97-.93-.92-.95.95.95.94Z\"/></svg>Fechar o dia</a></nav>",
      "css": ".ds-tabs{display:flex;gap:4px;border-bottom:1px solid var(--outline-variant,#DCCFCD)}.ds-tab{font-family:'Google Sans','Segoe UI',system-ui,sans-serif;height:48px;padding:0 16px;display:inline-flex;align-items:center;gap:8px;position:relative;color:var(--on-surface-variant,#5C4F4F);text-decoration:none;font-weight:500;font-size:14px;border-radius:8px 8px 0 0}.ds-tab:hover{color:var(--on-surface,#1F1A1A);background:var(--surface-high,#F1ECEB)}.ds-tab:focus-visible{outline:2px solid var(--primary,#D7383E);outline-offset:-2px}.ds-tab[aria-selected=\"true\"]{color:var(--primary,#D7383E)}.ds-tab[aria-selected=\"true\"]::after{content:\"\";position:absolute;left:12px;right:12px;bottom:0;height:3px;border-radius:3px 3px 0 0;background:var(--primary,#D7383E)}"
    },
    {
      "name": "Hero Headline Band",
      "kind": "card",
      "refersTo": "hero-band",
      "description": "Overview-only tonal band of figures with target and pace marker.",
      "html": "<div class=\"ds-band\"><div><div class=\"ds-ml\">Vendas de Outubro</div><div class=\"ds-mv\">18,4 M MT</div><div class=\"ds-bar\"><i style=\"--p:.88\"></i><b style=\"left:85%\"></b></div><div class=\"ds-ms\">88% da meta de 21,0 M MT</div></div><div><div class=\"ds-ml\">Conversão nas lojas</div><div class=\"ds-mv\">14,2%</div><div class=\"ds-bar\"><i style=\"--p:.89\"></i></div><div class=\"ds-ms\">Meta 16%: faltam 1,8 pontos</div></div></div>",
      "css": ".ds-band{font-family:'Google Sans','Segoe UI',system-ui,sans-serif;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));background:var(--primary-soft,#FFF0EE);border-radius:16px;color:var(--on-surface,#1F1A1A)}.ds-band>div{padding:18px 24px 20px;border-left:1px solid #F5DCD8}.ds-band>div:first-child{border-left:0}.ds-ml{font-weight:500;font-size:14px;color:var(--on-surface-variant,#5C4F4F)}.ds-mv{margin:6px 0 12px;font-size:34px;line-height:42px;letter-spacing:-.01em;font-variant-numeric:tabular-nums}.ds-bar{position:relative;height:8px;border-radius:4px;background:#F6D8D4}.ds-bar i{position:absolute;inset:0;border-radius:inherit;background:var(--hc-red,#EB4950);transform-origin:left;transform:scaleX(var(--p,0));transition:transform .7s cubic-bezier(.2,0,0,1)}.ds-bar b{position:absolute;top:-4px;bottom:-4px;width:2px;border-radius:1px;background:var(--on-surface,#1F1A1A)}.ds-band>div:hover .ds-bar i{transform:scaleX(1)}.ds-ms{margin-top:10px;font-size:13px;line-height:18px;color:var(--on-surface-variant,#5C4F4F)}"
    },
    {
      "name": "Status Chips",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Semantic state labels in tonal pairs.",
      "html": "<div style=\"display:flex;gap:8px;flex-wrap:wrap\"><span class=\"ds-st ds-ok\">Concluído</span><span class=\"ds-st ds-warn\">Por cobrar</span><span class=\"ds-st ds-bad\">Atrasado</span><span class=\"ds-st ds-info\">Em entrega</span><span class=\"ds-st\">Em preparação</span></div>",
      "css": ".ds-st{font-family:'Google Sans','Segoe UI',system-ui,sans-serif;display:inline-flex;align-items:center;height:24px;padding:0 8px;border-radius:6px;font-weight:500;font-size:12px;line-height:16px;background:var(--neu-c,#EDE7E6);color:var(--neu,#4D4545)}.ds-ok{background:var(--ok-c,#D6EEDC);color:var(--ok,#1B6A3B)}.ds-warn{background:var(--warn-c,#FFE2BA);color:var(--warn,#835000)}.ds-bad{background:var(--bad-c,#FADCD9);color:var(--bad,#B3261E)}.ds-info{background:var(--info-c,#DCE6FA);color:var(--info,#0B57D0)}"
    },
    {
      "name": "Snackbar with Undo",
      "kind": "custom",
      "refersTo": "snackbar",
      "description": "Inverse confirmation after a commit, with undo; the single authored motion.",
      "html": "<div class=\"ds-snack\"><p>Fecho de Matola registado.</p><button class=\"ds-sa\">Anular</button></div>",
      "css": ".ds-snack{font-family:'Google Sans','Segoe UI',system-ui,sans-serif;display:flex;align-items:center;gap:8px;max-width:420px;min-height:48px;padding:6px 8px 6px 16px;border-radius:8px;background:var(--inverse,#352F2F);color:var(--on-inverse,#F8EEED);box-shadow:0 4px 10px rgba(0,0,0,.18),0 10px 28px rgba(0,0,0,.14);font-size:14px}.ds-snack p{margin:0;flex:1}.ds-sa{font-family:'Google Sans','Segoe UI',system-ui,sans-serif;height:36px;padding:0 12px;border:0;border-radius:18px;background:transparent;color:var(--inverse-primary,#FFB3AE);font-weight:500;font-size:14px;cursor:pointer}.ds-sa:hover{background:rgba(255,179,174,.08)}.ds-sa:focus-visible{outline:2px solid var(--inverse-primary,#FFB3AE);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Store's Day on One Console",
    "overview": "A Google-Workspace-grade Material 3 light scheme, seeded from a lighter Home Center red and laid on warm, faintly rose neutral surfaces. Depth is tonal: the page sits on a warm grey (`bg`), content lives on white cards, and selection is a rose container. Nothing floats at rest. The interface is dense in the way an operating console is dense: every figure carries its source, its target and a progress bar with a pace marker, and every alert carries the button that resolves it.\n\nThe system separates two reds on purpose. The deeper action red (`primary`) is for things you press and read as links, because it holds 4.6:1 against white. The brighter brand red (`hc-red`) is for things you look at: progress bars, the current month's column, completed stepper nodes, the funnel's last stage. Semantic state uses its own tonal pairs (ok, warn, bad, info, neutral), never the brand reds.\n\nMotion is reserved for one moment: after the day's data is committed, the changed figures count up to their new values and the bars rescale, and an inverse snackbar offers undo. Everything else is a 150 ms state-layer change.",
    "keyCharacteristics": [
      "Google Sans in every role, tabular numerals on every figure.",
      "Material Symbols Rounded (outlined, filled when active) for UI icons; Simple Icons brand marks, in brand colour, for channels.",
      "Tonal layering over shadow; shadows only on transient, floating surfaces.",
      "Pill controls (buttons, options, segmented selector, nav indicator) against 8/12/16/28 container corners.",
      "Adaptive navigation: drawer, rail, bottom bar; container queries drive the grids."
    ],
    "rules": [
      {
        "name": "The Two Reds Rule",
        "body": "`primary` is for what you press; `hc-red` is for what you read in a chart. A button in `hc-red` or a bar in `primary` is a mistake.",
        "section": "colors"
      },
      {
        "name": "The Rose Means Selected Rule",
        "body": "The `sel` / `on-sel` container is the single selection language across nav, chips, segments, options and tonal buttons. Do not invent another selected style.",
        "section": "colors"
      },
      {
        "name": "The State Is Not Brand Rule",
        "body": "Late, overdue, at-risk and done use the semantic pairs, never the brand reds.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Every number that can change or be compared (figures, table cells, counts, bar labels, preview values) sets `font-variant-numeric: tabular-nums`, so counting up and comparing stores never jitters.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "No uppercase, no tracked-out labels. Hierarchy comes from size and the 400/500 weight step.",
        "section": "typography"
      },
      {
        "name": "The Container Decides Rule",
        "body": "Grid changes are `@container main` queries; only navigation chrome uses media queries.",
        "section": "layout"
      },
      {
        "name": "The No Clipped Columns Rule",
        "body": "Below 700px a table becomes cards; it never side-scrolls its key columns away.",
        "section": "layout"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "Cards, bands, tables and the pipeline have no shadow. If it does not float or respond to hover, it does not cast.",
        "section": "elevation"
      },
      {
        "name": "The One Moment Rule",
        "body": "The commit (count-up, bar rescale, undo snackbar) is the only authored motion. Everything else is a 150 ms colour change on `cubic-bezier(.2,0,0,1)`.",
        "section": "components"
      },
      {
        "name": "The Every Alert Acts Rule",
        "body": "An alert row is count, description, and an outlined action button that resolves it on the spot.",
        "section": "components"
      },
      {
        "name": "The Mark The Entry Rule",
        "body": "Any tab or button that writes data carries the `edit_note` icon.",
        "section": "components"
      }
    ],
    "dos": [
      "Do set every figure in Google Sans with tabular numerals, and pair it with its source and its target.",
      "Do use `primary` (#D7383E) for actions and links and `hc-red` (#EB4950) for bars and indicators.",
      "Do express every selected state with the `sel` / `on-sel` container.",
      "Do separate surfaces by tone (`bg`, `surface`, `surface-low`) and keep cards flat at rest.",
      "Do use Material Symbols Rounded for UI icons (filled when active) and Simple Icons marks in brand colour for channels.",
      "Do let `@container main` decide grid columns, and turn tables into cards at 700px.",
      "Do keep controls as full pills and containers on the 8/12/16/28 scale."
    ],
    "donts": [
      "Don't put a dark sidebar over a row of identical white KPI tiles; the drawer sits on the warm page and the overview leads with one tonal band.",
      "Don't use the brand reds for status; late, overdue and at-risk use the Bad, Warn and Ok pairs.",
      "Don't add shadows to cards, bands, tables or the pipeline.",
      "Don't add motion beyond the commit moment and 150 ms state changes.",
      "Don't use uppercase or letter-spaced labels; hierarchy is size and the 400/500 step.",
      "Don't use placeholder text as a field label; labels stay floated on the stroke."
    ]
  }
}